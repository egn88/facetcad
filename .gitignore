# Local agent settings. Ignored here rather than relying on a global excludes
# file, which protects only the machine it is configured on.
.claude/

# Local compose overrides. Anything describing a real deployment — hostnames,
# proxy conventions, server paths — is kept outside this repository entirely
# rather than ignored inside it, so that no single mistaken `git add -f` or
# edit to this file can publish it.
docker-compose.override.yml
*.env
